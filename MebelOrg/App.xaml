<Application x:Class="MebelOrg.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnLastWindowClose">
    <Application.Resources>
        <FontFamily x:Key="AppFont">Arial</FontFamily>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#6A5ACD"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#4B0082"/>
        <SolidColorBrush x:Key="DiscountBrush" Color="#483D8B"/>
    </Application.Resources>
</Application>
