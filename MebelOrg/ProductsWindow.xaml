<Window x:Class="MebelOrg.ProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товары — ООО «МебельОрг»" Height="620" Width="900"
        WindowStartupLocation="CenterScreen" FontFamily="Calibri" Background="White">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Image Source="Images/icon.png" Height="52" DockPanel.Dock="Left" Margin="0,0,12,0"/>
            <StackPanel>
                <TextBlock Text="Список товаров" FontSize="20" FontWeight="Bold" Foreground="#0000FF"/>
                <TextBlock x:Name="UserInfo" FontSize="12" Foreground="#555"/>
            </StackPanel>
        </DockPanel>

        <DockPanel x:Name="ControlsPanel" Grid.Row="1" Margin="0,0,0,10" Visibility="Collapsed">
            <TextBlock Text="Поиск:" VerticalAlignment="Center"/>
            <TextBox x:Name="SearchBox" Width="160" Margin="4,0,14,0" TextChanged="Refresh_Changed" VerticalContentAlignment="Center"/>
            <TextBlock Text="Категория:" VerticalAlignment="Center"/>
            <ComboBox x:Name="FilterBox" Width="180" Margin="4,0,14,0" SelectionChanged="Refresh_Changed"/>
            <TextBlock Text="Сортировка:" VerticalAlignment="Center"/>
            <ComboBox x:Name="SortBox" Width="140" Margin="4,0,14,0" SelectionChanged="Refresh_Changed">
                <ComboBoxItem>Без сортировки</ComboBoxItem>
                <ComboBoxItem>Цена ↑</ComboBoxItem>
                <ComboBoxItem>Цена ↓</ComboBoxItem>
            </ComboBox>
        </DockPanel>

        <ListBox x:Name="ProductList" Grid.Row="2" BorderThickness="0" Background="White">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="Card" Padding="8" Margin="0,0,0,6" CornerRadius="4">
                        <DockPanel Width="820">
                            <Image Source="{Binding PhotoPath}" Width="90" Height="70" Stretch="Uniform" DockPanel.Dock="Left" Margin="0,0,12,0"/>
                            <StackPanel DockPanel.Dock="Right" Width="130" Margin="10,0,0,0">
                                <TextBlock Text="{Binding PriceOld}" Foreground="Gray" TextDecorations="Strikethrough" FontSize="12" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding PriceNew}" FontWeight="Bold" FontSize="15" Foreground="#0000FF" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding DiscountText}" FontSize="12" Foreground="Black" Margin="0,4,0,0" HorizontalAlignment="Right" Padding="4,1">
                                    <TextBlock.Background>
                                        <SolidColorBrush Color="#00FFFF"/>
                                    </TextBlock.Background>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock FontWeight="Bold" FontSize="14">
                                    <Run Text="{Binding Article}"/><Run Text=" | "/><Run Text="{Binding Name}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Category}" Foreground="#555" FontSize="12"/>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" MaxHeight="48"/>
                                <TextBlock FontSize="12"><Run Text="Производитель: "/><Run Text="{Binding Manufacturer}"/><Run Text="   Поставщик: "/><Run Text="{Binding Supplier}"/></TextBlock>
                                <TextBlock FontSize="12"><Run Text="На складе: "/><Run Text="{Binding Stock}"/><Run Text=" "/><Run Text="{Binding Unit}"/></TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding BigDiscount}" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="#008080"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding BigDiscount}" Value="False">
                            <Setter TargetName="Card" Property="Background" Value="#EBEBF5"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <Button x:Name="OrdersBtn" Content="Заказы" Click="Orders_Click" Padding="14,6"
                    Visibility="Collapsed" DockPanel.Dock="Left" Margin="0,0,8,0"/>
            <Button x:Name="AddBtn" Content="Добавить товар" Click="Add_Click" Padding="14,6"
                    Visibility="Collapsed" DockPanel.Dock="Left" Margin="0,0,8,0"/>
            <Button x:Name="EditBtn" Content="Редактировать" Click="Edit_Click" Padding="14,6"
                    Visibility="Collapsed" DockPanel.Dock="Left" Margin="0,0,8,0"/>
            <Button x:Name="DeleteBtn" Content="Удалить" Click="Delete_Click" Padding="14,6"
                    Visibility="Collapsed" DockPanel.Dock="Left"/>
        </DockPanel>
    </Grid>
</Window>
