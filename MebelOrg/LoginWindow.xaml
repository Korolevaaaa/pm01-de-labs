<Window x:Class="MebelOrg.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход — ООО «МебельОрг»" Height="330" Width="420"
        WindowStartupLocation="CenterScreen" FontFamily="Calibri" Background="White">
    <StackPanel Margin="24">
        <Image Source="Images/icon.png" Height="80" Margin="0,0,0,12"/>
        <TextBlock Text="Авторизация" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"
                   Foreground="#0000FF"/>
        <TextBlock Text="Логин"/>
        <TextBox x:Name="LoginBox" Margin="0,2,0,8" Padding="4"/>
        <TextBlock Text="Пароль"/>
        <PasswordBox x:Name="PasswordBox" Margin="0,2,0,14" Padding="4"/>
        <Button Content="Войти" Click="Login_Click" Padding="10,6"
                Background="#00FFFF" Foreground="Black" BorderThickness="0"/>
        <Button Content="Войти как гость" Click="Guest_Click" Margin="0,8,0,0" Padding="10,6"/>
        <TextBlock x:Name="ErrorText" Foreground="Red" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</Window>
