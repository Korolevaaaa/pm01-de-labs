<Window x:Class="MebelOrg.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказы — ООО «МебельОрг»" Height="540" Width="860"
        WindowStartupLocation="CenterScreen" FontFamily="Calibri" Background="White">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Заказы" FontSize="20" FontWeight="Bold" Foreground="#0000FF" Margin="0,0,0,10"/>
        <ListView x:Name="OrderList" Grid.Row="1">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="№" DisplayMemberBinding="{Binding Id}" Width="40"/>
                    <GridViewColumn Header="Состав" DisplayMemberBinding="{Binding Composition}" Width="220"/>
                    <GridViewColumn Header="Дата заказа" DisplayMemberBinding="{Binding OrderDate}" Width="95"/>
                    <GridViewColumn Header="Доставка" DisplayMemberBinding="{Binding DeliveryDate}" Width="95"/>
                    <GridViewColumn Header="Пункт выдачи" DisplayMemberBinding="{Binding Pickup}" Width="200"/>
                    <GridViewColumn Header="Клиент" DisplayMemberBinding="{Binding ClientFIO}" Width="160"/>
                    <GridViewColumn Header="Код" DisplayMemberBinding="{Binding Code}" Width="50"/>
                    <GridViewColumn Header="Статус" DisplayMemberBinding="{Binding Status}" Width="90"/>
                </GridView>
            </ListView.View>
        </ListView>
        <DockPanel Grid.Row="2" Margin="0,10,0,0" x:Name="AdminPanel" Visibility="Collapsed">
            <Button Content="Добавить" Click="Add_Click" Padding="14,6" Margin="0,0,8,0"/>
            <Button Content="Редактировать" Click="Edit_Click" Padding="14,6" Margin="0,0,8,0"/>
            <Button Content="Удалить" Click="Delete_Click" Padding="14,6"/>
        </DockPanel>
    </Grid>
</Window>
