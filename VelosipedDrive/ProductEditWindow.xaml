<Window x:Class="VelosipedDrive.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар — ООО «ВелосипедДрайв»" Height="640" Width="560"
        WindowStartupLocation="CenterScreen" FontFamily="Arial" Background="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock x:Name="Header" Text="Редактирование товара" FontSize="18" FontWeight="Bold" Foreground="#4B0082" Margin="0,0,0,12"/>
            <TextBlock Text="Артикул"/><TextBox x:Name="ArticleBox" Margin="0,2,0,6"/>
            <TextBlock Text="Наименование"/><TextBox x:Name="NameBox" Margin="0,2,0,6" TextWrapping="Wrap"/>
            <TextBlock Text="Единица измерения"/><TextBox x:Name="UnitBox" Margin="0,2,0,6"/>
            <TextBlock Text="Цена"/><TextBox x:Name="PriceBox" Margin="0,2,0,6"/>
            <TextBlock Text="Поставщик"/><TextBox x:Name="SupplierBox" Margin="0,2,0,6"/>
            <TextBlock Text="Производитель"/><TextBox x:Name="ManufacturerBox" Margin="0,2,0,6"/>
            <TextBlock Text="Категория"/><TextBox x:Name="CategoryBox" Margin="0,2,0,6"/>
            <TextBlock Text="Скидка, %"/><TextBox x:Name="DiscountBox" Margin="0,2,0,6"/>
            <TextBlock Text="Количество на складе"/><TextBox x:Name="StockBox" Margin="0,2,0,6"/>
            <TextBlock Text="Описание"/><TextBox x:Name="DescriptionBox" Margin="0,2,0,10" TextWrapping="Wrap" MinHeight="48" AcceptsReturn="True"/>

            <TextBlock Text="Фото товара"/>
            <Image x:Name="PhotoPreview" Height="120" Stretch="Uniform" Margin="0,4,0,6"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Выбрать фото…" Click="PickPhoto_Click" Padding="10,5" Margin="0,0,8,0"/>
                <Button Content="Убрать фото" Click="ClearPhoto_Click" Padding="10,5"/>
            </StackPanel>
            <TextBlock x:Name="PhotoPathText" FontSize="11" Foreground="#777" Margin="0,4,0,12" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Сохранить" Click="Save_Click" Padding="16,7" Background="#6A5ACD" Foreground="White" BorderThickness="0" Margin="0,0,8,0"/>
                <Button Content="Отмена" Click="Cancel_Click" Padding="16,7"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
